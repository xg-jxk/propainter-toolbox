/* ProPainter 工具箱 —— 浅色 + 蓝色强调 */
QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #20242c;
    background: #f6f7fb;
}

QMainWindow, QDialog {
    background: #f6f7fb;
}

QLabel#title {
    font-size: 20px;
    font-weight: 600;
    color: #16233d;
}

QLabel#runtime {
    color: #5b6472;
    padding-left: 8px;
}

QLabel#dropLabel {
    color: #5b6472;
    font-size: 14px;
}

QFrame#dropArea {
    background: #fbfcff;
    border: 2px dashed #9aabd0;
    border-radius: 12px;
}

QFrame#dropArea:hover {
    border-color: #2f6feb;
    background: #f2f6ff;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #e2e7f2;
    border-radius: 10px;
    margin-top: 14px;
    padding: 10px 12px 12px 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #3d4a63;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #d3daea;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 20px;
}

QPushButton:hover {
    border-color: #2f6feb;
    color: #2f6feb;
}

QPushButton:disabled {
    color: #a3abbd;
    border-color: #e6eaf3;
    background: #f1f3f8;
}

QPushButton#primary {
    background: #2f6feb;
    border: 1px solid #2f6feb;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primary:hover {
    background: #245bd0;
    border-color: #245bd0;
    color: #ffffff;
}

QPushButton#primary:disabled {
    background: #b9c8e8;
    border-color: #b9c8e8;
    color: #f2f5fb;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    border: 1px solid #d3daea;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 22px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2f6feb;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #f1f3f8;
    color: #a3abbd;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QTableWidget {
    background: #ffffff;
    border: 1px solid #e2e7f2;
    border-radius: 8px;
    gridline-color: #eef1f7;
    alternate-background-color: #fafbff;
}

QHeaderView::section {
    background: #f2f5fb;
    border: none;
    border-bottom: 1px solid #e2e7f2;
    padding: 6px 8px;
    font-weight: 600;
    color: #3d4a63;
}

QTableWidget::item:selected {
    background: #e6efff;
    color: #16233d;
}

QProgressBar {
    background: #e8ecf5;
    border: none;
    border-radius: 7px;
    height: 14px;
    text-align: center;
    color: #4a5568;
}

QProgressBar::chunk {
    background: #2f6feb;
    border-radius: 7px;
}

/* 底部运行状态条：主操作 / 进度 / 状态 / 维护按钮 */
QFrame#statusStrip {
    background: #f6f8fc;
    border: 1px solid #e2e7f0;
    border-radius: 9px;
}

QFrame#statusStrip QLabel#hintLabel {
    color: #3f4b63;
}

QPushButton#ghostButton {
    background: transparent;
    border: 1px solid #d8dfeb;
    border-radius: 6px;
    color: #4a5568;
    padding: 2px 10px;
}

QPushButton#ghostButton:hover {
    background: #eef2f9;
    border-color: #c3cee0;
}

QPlainTextEdit {
    background: #0f1420;
    color: #cfd8e6;
    border: 1px solid #1b2233;
    border-radius: 8px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    padding: 8px;
}

/* 参数旁的「i」用自绘气泡；其它控件统一走原生 tooltip，样式在这里 */
QToolTip {
    background: #1b2433;
    color: #dbe4f3;
    border: 1px solid #2b3a52;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 12px;
}

QCheckBox {
    spacing: 6px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #c6cfe0;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
}
/* ---- 参数说明「i」与 GitHub 入口 ---- */
QLabel#infoIcon {
    color: #6b7488;
    background: #ffffff;
    border: 1px solid #c3cbdc;
    border-radius: 7px;
    font-size: 10px;
    font-weight: 600;
}

QLabel#infoIcon:hover {
    color: #ffffff;
    background: #2f6feb;
    border-color: #2f6feb;
}

QToolButton#ghButton {
    background: #ffffff;
    border: 1px solid #d3daea;
    border-radius: 8px;
    padding: 5px 10px;
    color: #20242c;
}

QToolButton#ghButton:hover {
    border-color: #2f6feb;
    color: #2f6feb;
}
/* ---- 卡片 / 分段按钮 / 预设 ---- */
QFrame#moduleCard {
    background: #ffffff;
    border: 1px solid #e2e7f2;
    border-radius: 10px;
}

QCheckBox#cardTitle {
    font-weight: 600;
    color: #3d4a63;
    spacing: 6px;
}

QLabel#sectionTitle {
    font-weight: 600;
    color: #3d4a63;
}

QLabel#hintLabel {
    color: #6b7488;
}

QRadioButton#segButton {
    background: #ffffff;
    border: 1px solid #d3daea;
    border-radius: 6px;
    padding: 6px 14px;
    color: #4a5568;
}

QRadioButton#segButton:hover {
    border-color: #2f6feb;
    color: #2f6feb;
}

QRadioButton#segButton:checked {
    background: #2f6feb;
    border-color: #2f6feb;
    color: #ffffff;
}

QRadioButton#segButton::indicator {
    width: 0;
    height: 0;
}

QToolButton#advButton {
    border: none;
    color: #5b6472;
    padding: 2px 0;
    background: transparent;
}

QToolButton#advButton:hover {
    color: #2f6feb;
}

QPushButton#presetButton {
    border-radius: 14px;
    padding: 5px 14px;
}

QPushButton#presetButton:checked {
    background: #e6efff;
    border-color: #2f6feb;
    color: #2f6feb;
    font-weight: 600;
}
QLabel#helpBubble {
    background: #1f2937;
    color: #dbe4f3;
    border: 1px solid #3a4a63;
    border-radius: 8px;
    font-size: 12px;
}
QFrame#presetBar {
    background: #f5f8ff;
    border: 1px solid #dbe3f3;
    border-radius: 10px;
}

/* ---- 间距 token：输入控件统一高度、提示文字小一号 ---- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    min-height: 26px;
}

QLabel#hintLabel {
    color: #6b7488;
    font-size: 12px;
}

/* ---- 统一字段：label / 控件 / 简介 ---- */
QLabel#fieldLabel {
    font-size: 13px;
    font-weight: 500;
    color: #3d4a63;
}

QLabel#fieldHint {
    font-size: 12px;
    color: #7b8496;
}

QFrame#cardSep {
    background: #e8edf7;
    border: none;
}
